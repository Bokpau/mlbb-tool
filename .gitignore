.vercel
node_modules

# OS / editor cruft
.DS_Store
**/.DS_Store
Thumbs.db

# Generated/scraped assets — too large/ephemeral for git
int_player_history/resources/
int_player_history/*.html
int_player_history/player_img_map2.json

# Local env / secrets — never commit these
.env
.env.*
!.env.example

# Heavy image folders — local-only by default (BOK: remove a line here to start pushing that folder)
# _raw/ = uncompressed masters + working files; hero_transparent has files >20MB (jsDelivr won't serve those anyway)
_raw/
hero_transparent/

# Generated knowledge graph — fully ignored, including the wiki and GRAPH_REPORT.
# The wiki and report used to be versioned as "human-readable docs", but the
# PostToolUse hook regenerates them after every edit, so ~250 tracked files
# churned on every commit and buried real changes in the diff. All of it is
# derived deterministically from source: delete it and graphify rebuilds it.
graphify-out/
