# Copy this file to .env (or set these in Vercel → Project → Settings → Environment Variables).
# Never commit real values. .env is gitignored.

# Password required to access the app (the login screen).
APP_PASSWORD=change-me

# Long random string used to sign session cookies.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-string

# Upstream MLBB esports data auth key (kept server-side only — never sent to the browser).
MLBB_AUTH=your-mlbb-authkey

# Render backend (mpl-ph-s17-backend) — source of the live battle ID.
# api/latestbattle.js calls RENDER_URL/admin/live/current with TOOL_TOKEN in an
# x-tool-token header. TOOL_TOKEN must equal the backend's TOOL_TOKEN env var.
# Server-side only. Unset = Auto mode stays idle; manual Fetch uses the judge.
RENDER_URL=https://your-backend.onrender.com
TOOL_TOKEN=change-me

# Judge account used ONLY by the manual Fetch fallback when Render has no live
# battle (api/latestbattle.js). Optional; defaults to the old hardcoded judge.
MLBB_JUDGE_ID=1866747937
